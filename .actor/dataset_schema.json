{
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "source": { "type": "string", "title": "Source" },
      "searchQuery": { "type": "string", "title": "Search" },
      "position": { "type": "integer", "title": "Position" },
      "productId": { "type": ["string", "null"], "title": "Product ID" },
      "title": { "type": "string", "title": "Product" },
      "brand": { "type": "string", "title": "Brand" },
      "price": { "type": ["number", "null"], "title": "Price" },
      "mrp": { "type": ["number", "null"], "title": "MRP" },
      "discountPercent": { "type": ["integer", "null"], "title": "Discount %" },
      "currency": { "type": "string", "title": "Currency" },
      "packSize": { "type": "string", "title": "Pack size" },
      "normalizedPackSize": { "type": ["string", "null"], "title": "Normalized pack size" },
      "packIdentity": { "type": ["string", "null"], "title": "Pack identity" },
      "packNormalizationStatus": { "type": "string", "enum": ["parsed", "unrecognized"], "title": "Pack parsing" },
      "packCount": { "type": ["integer", "null"], "title": "Pack count" },
      "totalQuantity": { "type": ["number", "null"], "title": "Total quantity" },
      "quantityUnit": { "type": ["string", "null"], "enum": ["g", "ml", "piece", null], "title": "Quantity unit" },
      "unitPrice": { "type": ["number", "null"], "title": "Unit price (INR)" },
      "unitPriceBasis": { "type": ["string", "null"], "enum": ["100 g", "1 L", "1 piece", null], "title": "Unit price basis" },
      "sourcePincode": { "type": ["string", "null"], "title": "Source pincode" },
      "sourceCity": { "type": ["string", "null"], "title": "Source city" },
      "sourceCityId": { "type": ["integer", "null"], "title": "Source city ID" },
      "sourceAddressIsPartial": { "type": ["boolean", "null"], "title": "Partial source context" },
      "sourceServiceAreaId": { "type": ["integer", "null"], "title": "Product service area ID" },
      "sourceFulfillmentCenterId": { "type": ["integer", "null"], "title": "Product fulfillment center ID" },
      "locationContextStatus": { "type": "string", "enum": ["source_assigned", "product_context_only", "unavailable"], "title": "Source context status" },
      "deliveryLocationVerified": { "type": "boolean", "const": false, "title": "Delivery location verified", "description": "Always false: source-assigned anonymous context is not delivery-location selection or a fulfillment guarantee." },
      "category": { "type": "string", "title": "Category" },
      "rating": { "type": ["number", "null"], "title": "Rating" },
      "ratingCount": { "type": ["integer", "null"], "title": "Ratings" },
      "inStock": { "type": ["boolean", "null"], "title": "In stock" },
      "trackingEnabled": { "type": "boolean", "title": "Tracking enabled" },
      "changeDetected": { "type": "boolean", "title": "Changed" },
      "changeType": { "type": ["string", "null"], "title": "Change type" },
      "changeTypes": { "type": "array", "items": { "type": "string" }, "title": "All observed changes" },
      "alertTriggered": { "type": "boolean", "title": "Alert triggered" },
      "alertReasons": { "type": "array", "items": { "type": "string" }, "title": "Alert reasons" },
      "comparisonSkippedReason": { "type": ["string", "null"], "title": "Comparison skipped reason" },
      "historyCount": { "type": "integer", "title": "Retained observations" },
      "trackingRegion": { "type": "string", "title": "Monitoring label" },
      "priceHistory": {
        "type": "array",
        "title": "Bounded observation history",
        "maxItems": 90,
        "items": {
          "type": "object",
          "properties": {
            "observedAt": { "type": "string", "format": "date-time" },
            "price": { "type": ["number", "null"] },
            "inStock": { "type": ["boolean", "null"] },
            "packSize": { "type": "string" }
          },
          "required": ["observedAt", "price", "inStock", "packSize"]
        }
      },
      "previousPrice": { "type": ["number", "null"], "title": "Previous price" },
      "priceChange": { "type": ["number", "null"], "title": "Price change" },
      "priceChangePercent": { "type": ["number", "null"], "title": "Price change %" },
      "previousInStock": { "type": ["boolean", "null"], "title": "Previously in stock" },
      "stockChanged": { "type": "boolean", "title": "Stock changed" },
      "firstSeenAt": { "type": ["string", "null"], "title": "First seen" },
      "previousScrapedAt": { "type": ["string", "null"], "title": "Previous scrape" },
      "productUrl": { "type": ["string", "null"], "title": "Product URL" },
      "imageUrl": { "type": ["string", "null"], "title": "Image" },
      "scrapedAt": { "type": "string", "title": "Scraped at" }
    }
  },
  "views": {
